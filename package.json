{
  "name": "@beatapi/beat-browser",
  "version": "1.4.1",
  "description": "BeatBrowser — a local MCP toolkit for your signed-in Chrome. Use it across compatible agents.",
  "type": "module",
  "bin": {
    "beat-browser": "src/cli.js"
  },
  "files": [
    "src",
    "extension",
    "media/hero.webp",
    "media/compare-agents.webp",
    "media/architecture.png",
    "media/architecture.svg",
    "skills",
    "AGENT_INSTALL.md",
    "README.md",
    "PRIVACY.md",
    "TEST_RESULTS.md",
    "docs/JEV_FAST_AGENT.md",
    "docs/JEV_BENCHMARK.md",
    "docs/JEV_BENCHMARK_RESULTS.json",
    "docs/learnings/x.com.md",
    "docs/COMPARISON.md",
    "docs/DEMO.md",
    "docs/RELEASING.md",
    "docs/RELEASE_NOTES.md",
    "scripts",
    "test/fixtures/fast-agent.html",
    "test/fixtures/demo.html",
    "docs/playbooks/x-reply.md",
    "docs/playbooks/x-reply-team-pack.md",
    "docs/TASKSPACES.md",
    "docs/EGO_PARITY_REVIEW.md",
    "docs/EGO_API_PARITY.csv",
    "docs/JAVASCRIPT.md",
    "docs/HUASHU_UPSTREAM_REVIEW.md",
    "docs/UPSTREAM_MAINTENANCE.md",
    "docs/upstream-sources.json",
    "docs/PREVIEW_TESTING.md",
    "README.zh-CN.md",
    "media/readme-cover.svg",
    "media/readme-cover.png",
    "media/readme-journey.en.png",
    "media/readme-journey.zh-CN.png",
    "media/readme-journey.en.svg",
    "media/readme-journey.zh-CN.svg",
    "media/readme-comparison.en.png",
    "media/readme-comparison.zh-CN.png",
    "media/readme-workspace.en.png",
    "media/readme-workspace.zh-CN.png",
    "docs/INSTALL.md",
    "docs/REMOTE.md",
    "docs/REMOTE.zh-CN.md",
    "docs/AGENT_DIRECTORY.md",
    "docs/AGENT_DIRECTORY.zh-CN.md",
    "media/readme-workflow.en.svg",
    "media/readme-workspace.en.svg",
    "media/readme-workflow.zh-CN.svg",
    "media/readme-workspace.zh-CN.svg",
    "docs/comparison-data.json",
    "docs/comparisons",
    "media/readme-comparison.en.svg",
    "media/readme-comparison.zh-CN.svg",
    "media/readme-cover.en.svg",
    "media/readme-cover.zh-CN.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mcp": "node src/cli.js mcp",
    "bridge": "node src/cli.js bridge --foreground",
    "doctor": "node src/cli.js doctor",
    "test": "node --test test/*.test.js",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:security": "node scripts/check-security.mjs",
    "build:extension": "node scripts/pack-extension.mjs",
    "benchmark:offline": "node scripts/benchmark-fast-agent.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "check:comparison": "node scripts/render-comparison.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.18.3"
  },
  "keywords": [
    "beatbrowser",
    "beat-browser",
    "mcp",
    "mcp-server",
    "chrome-extension",
    "chrome",
    "browser-automation",
    "beatapi",
    "claude-code",
    "codex",
    "cursor",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "BeatAPI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BeatAPI/BeatBrowser.git"
  },
  "homepage": "https://beatapi.io/browser",
  "bugs": {
    "url": "https://github.com/BeatAPI/BeatBrowser/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    "./browser": "./src/browser.js",
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  }
}
